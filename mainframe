using UnityEngine;
using UnityEngine.UI;

public class GuitarTunerE4 : MonoBehaviour
{
    [Header("Настройки ")]
    public float targetFrequency = 329.63f;
    public float tolerance = 1.0f;
    public float volumeThreshold = 0.01f;

  

    [Header("Ссылки  (SpriteRenderer)")]
    public SpriteRenderer lowIndicator;
    public SpriteRenderer highIndicator;
    public SpriteRenderer okIndicator;

    [Header("Цвета")]
    public Color activeColor = Color.green;
    public Color inactiveColor = new Color(1f, 1f, 1f, 0.2f);

    public Color activeColor2 = Color.green;
    public Color inactiveColor2 = new Color(1f, 1f, 1f, 0.2f);

    public Color activeColor3 = Color.green;
    public Color inactiveColor3 = new Color(1f, 1f, 1f, 0.2f);

    [Header("Плавность и удержание")]
    [Tooltip("Скорость плавного перехода цвета")]
    public float colorLerpSpeed = 5f;

    [Tooltip("Сколько секунд держать цвет после исчезновения")]
    public float holdDuration = 1.0f;

    [Header("Отладка")]
    public string currentStatus = "—";
    public float detectedFrequency = 0f;

    private AudioClip microphoneClip;
    private string microphoneDevice;
    private const int SampleRate = 44100;
    private const int ClipLengthSeconds = 1;

    // Таймер удержания для каждого 
    private float lowHoldTimer = 0f;
    private float highHoldTimer = 0f;
    private float okHoldTimer = 0f;

    void Start()
    {
        if (Microphone.devices.Length == 0)
        {
            Debug.LogError("Устройство не найдено!");
            return;
        }

        microphoneDevice = Microphone.devices[0];
        microphoneClip = Microphone.Start(microphoneDevice, true, ClipLengthSeconds, SampleRate);

        // Сразу ставим неактивный цвет
        if (lowIndicator != null) lowIndicator.color = inactiveColor;
        if (highIndicator != null) highIndicator.color = inactiveColor;
        if (okIndicator != null) okIndicator.color = inactiveColor;
    }

    void Update()
    {
        // 1. Анализ  (только если есть данные)
        if (microphoneClip != null)
        {
            int micPosition = Microphone.GetPosition(microphoneDevice);
            if (micPosition >= 1024)
            {
                float[] samples = new float[1024];
                int startPosition = micPosition - 1024;
                if (startPosition < 0) startPosition += microphoneClip.samples;
                microphoneClip.GetData(samples, startPosition);

                float volume = GetRMS(samples);
                if (volume >= volumeThreshold)
                {
                    detectedFrequency = DetectPitch(samples, SampleRate);

                    if (detectedFrequency > 0f)
                    {
                        float diff = detectedFrequency - targetFrequency;
                        if (Mathf.Abs(diff) <= tolerance) currentStatus = "ok";
                        else if (diff < 0) currentStatus = "low";
                        else currentStatus = "high";

                        // Сбрасываем таймер 
                        ResetHoldTimer(currentStatus);
                    }
                }
            }
        }

        // 2. Уменьшаем таймеры удержания
        if (lowHoldTimer > 0f) lowHoldTimer -= Time.deltaTime;
        if (highHoldTimer > 0f) highHoldTimer -= Time.deltaTime;
        if (okHoldTimer > 0f) okHoldTimer -= Time.deltaTime;

        // 3. Плавно обновляем цвета
        UpdateIndicatorsSmooth();
    }

    /// <summary>
    /// Сбрасывает таймер удержания для нужного на holdDuration секунд
    /// </summary>
    private void ResetHoldTimer(string status)
    {
        switch (status)
        {
            case "low": lowHoldTimer = holdDuration; break;
            case "high": highHoldTimer = holdDuration; break;
            case "ok": okHoldTimer = holdDuration; break;
        }
    }

    private float GetRMS(float[] samples)
    {
        float sum = 0f;
        for (int i = 0; i < samples.Length; i++) sum += samples[i] * samples[i];
        return Mathf.Sqrt(sum / samples.Length);
    }

    private float DetectPitch(float[] samples, int sampleRate)
    {
        int minLag = sampleRate / 1000;
        int maxLag = sampleRate / 50;
        float bestCorrelation = 0f;
        int bestLag = -1;

        for (int lag = minLag; lag < maxLag; lag++)
        {
            float correlation = 0f;
            for (int i = 0; i < samples.Length - lag; i++)
                correlation += samples[i] * samples[i + lag];

            if (correlation > bestCorrelation)
            {
                bestCorrelation = correlation;
                bestLag = lag;
            }
        }

        if (bestLag <= 0) return 0f;
        return (float)sampleRate / bestLag;
    }

    /// <summary>
    /// Плавно меняет цвет 
    /// Активный цвет держится holdDuration секунд после исчезновения звука.
    /// </summary>
    private void UpdateIndicatorsSmooth()
    {
        float t = Time.deltaTime * colorLerpSpeed;

        if (lowIndicator != null)
        {
            Color target = (lowHoldTimer > 0f) ? activeColor : inactiveColor;
            lowIndicator.color = Color.Lerp(lowIndicator.color, target, t);
        }

        if (highIndicator != null)
        {
            Color target = (highHoldTimer > 0f) ? activeColor2 : inactiveColor2;
            highIndicator.color = Color.Lerp(highIndicator.color, target, t);
        }

        if (okIndicator != null)
        {
            Color target = (okHoldTimer > 0f) ? activeColor3 : inactiveColor3;
            okIndicator.color = Color.Lerp(okIndicator.color, target, t);
        }
    }

    void OnDestroy()
    {
        if (Microphone.IsRecording(microphoneDevice))
            Microphone.End(microphoneDevice);
    }
}
